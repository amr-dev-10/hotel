APP_NAME=Arcadia Hotel Platform
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/arcadia
AUTO_CREATE_TABLES=true

JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
REFRESH_TOKEN_EXPIRE_DAYS=30
ENCRYPTION_KEY=
VAULT_MASTER_KEY=

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

WHATSAPP_VERIFY_TOKEN=replace-with-meta-verify-token
WHATSAPP_APP_SECRET=replace-with-meta-app-secret
WHATSAPP_ACCESS_TOKEN=replace-with-meta-access-token
WHATSAPP_API_VERSION=v19.0
WHATSAPP_DRY_RUN=true

GEMINI_API_KEY=
FCM_ENABLED=false
DEFAULT_TIMEZONE=UTC

STRIPE_SECRET_KEY=
MEDIA_STORAGE_BACKEND=local
S3_BUCKET=
S3_REGION=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
